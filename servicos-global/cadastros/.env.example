# Connection string para o banco gravity-cadastros (Railway).
CADASTROS_DATABASE_URL=

# Chave compartilhada entre serviços (validada via header x-internal-key).
# Mesmo valor TEM QUE estar definido no .env de quem chama (Pedido, LPCO, etc.).
# Em dev: gravity-dev-internal-key-2026
CHAVE_INTERNA_SERVICO=

# Porta do serviço (default 8030).
PORT=8030

# Cron diário NCM — somente produção (start-site.sh define NCM_CRON_ENABLED=1).
# Dev local: omitir ou NCM_CRON_ENABLED=0 para não disparar job contra banco compartilhado.
NCM_CRON_ENABLED=0

# Seed catálogo ISO 6346 (26 tipos):
#   npx tsx servicos-global/cadastros/prisma/seed-containers.ts

# URLs dos produtos consumidores — usadas pelo endpoint preview-impacto.
# Se ausentes, o produto correspondente retorna status='indisponivel'.
PEDIDO_BASE_URL=
LPCO_BASE_URL=
NF_IMPORTACAO_BASE_URL=
