# BID Frete Internacional — Server
PORT=8023
NODE_ENV=development
DATABASE_URL=postgresql://user:pass@localhost:5432/bid_frete_db

# S2S Configurador — validação multi-workspace (paridade Pedido)
CONFIGURATOR_URL=http://127.0.0.1:8005

# S2S Authentication — deve coincidir com Cadastros em dev (setup-dev.ts)
CHAVE_INTERNA_SERVICO=gravity-dev-internal-key-2026

# Catálogo global (taxa_origem_destino, portos, moedas…)
CADASTROS_SERVICE_URL=http://localhost:8031

# URLs dos servicos de tenant
EMAIL_SERVICE_URL=http://localhost:8008
WHATSAPP_SERVICE_URL=http://localhost:3001
ATIVIDADES_SERVICE_URL=http://localhost:3001
NOTIFICACOES_SERVICE_URL=http://localhost:3001
HISTORICO_SERVICE_URL=http://localhost:3001
GABI_SERVICE_URL=http://127.0.0.1:8009

# URL publica da aplicacao (shell — ex.: localhost:3000/bid-frete)
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
