// schema.prisma — GERADO AUTOMATICAMENTE por compose-schema.js
// NAO EDITAR DIRETAMENTE. Edite schema.base.prisma ou fragment.prisma.

// schema.base.prisma — Processo
// Composto via scripts/compose-schema.js -> gera schema.prisma final
// Skill: antigravity-criar-produto (Passo 8)

generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelos especificos do Processo sao definidos em fragment.prisma
// e compostos automaticamente pelo script compose-schema.js

// fragment.prisma — Processo (COMEX)
// Modelo híbrido DDD: cabeçalho + tabelas 1:1/N + links cross-produto (sem duplicar Pedido/BID).
// Skill: antigravity-database-governance, antigravity-schema-composition

// ─── PROCESSO (cabeçalho) ─────────────────────────────────────────────────────

model Processo {
  id_processo        String  @id @default(cuid())
  id_organizacao     String
  id_workspace       String
  id_produto_gravity String?
  id_usuario         String?

  numero_processo        String
  tipo_operacao_processo String

  referencia_interna_processo    String?
  referencia_importador_processo String?
  referencia_exportador_processo String?

  id_status_atual_processo          String?
  id_importacao_exportador_processo String?
  id_exportacao_importador_processo String?

  id_cotacao_bid_frete_internacional  String?
  id_proposta_bid_frete_internacional String?
  id_transito_processo                String?
  id_operacao_cambio_processo         String?

  id_responsavel_processo       String?
  responsavel_rotina_processo   String?
  setor_responsavel_processo    String?
  vendedor_responsavel_processo String?

  data_criacao_processo     DateTime @default(now())
  data_atualizacao_processo DateTime @updatedAt

  status_atual     ProcessoStatus?                 @relation(fields: [id_status_atual_processo], references: [id_processo_status], onDelete: SetNull)
  historico_status HistoricoStatusProcesso[]
  logistica        LogisticaInternacionalProcesso?
  dados            DadosProcesso?
  cambio           CambioProcesso?
  estimativa       EstimativaProcesso?
  containers       ContainerProcesso[]
  documentos       DocumentoProcesso[]
  follow_ups       FollowUpProcesso[]

  @@index([id_organizacao])
  @@index([id_organizacao, id_produto_gravity])
  @@index([id_organizacao, id_usuario])
  @@index([id_organizacao, id_workspace])
  @@index([id_organizacao, numero_processo])
  @@index([id_organizacao, id_status_atual_processo])
  @@index([id_organizacao, tipo_operacao_processo])
  @@map("processo")
}

// ─── STATUS (catálogo tenant) ─────────────────────────────────────────────────

model ProcessoStatus {
  id_processo_status String  @id @default(cuid())
  id_organizacao     String
  id_produto_gravity String?

  tipo_status_processo       String
  rotulo_status_processo     String
  cor_status_processo        String  @default("#6366F1")
  ordem_status_processo      Int     @default(0)
  regras_status_processo     Json?
  eh_padrao_status_processo  Boolean @default(false)
  eh_sistema_status_processo Boolean @default(false)

  data_criacao_processo_status     DateTime @default(now())
  data_atualizacao_processo_status DateTime @updatedAt

  processos          Processo[]
  historico_anterior HistoricoStatusProcesso[] @relation("status_anterior_processo")
  historico_novo     HistoricoStatusProcesso[] @relation("status_novo_processo")

  @@unique([id_organizacao, tipo_status_processo])
  @@index([id_organizacao])
  @@index([id_organizacao, id_produto_gravity])
  @@index([id_organizacao, ordem_status_processo])
  @@map("processo_status")
}

model HistoricoStatusProcesso {
  id_historico_status_processo       String   @id @default(cuid())
  id_organizacao                     String
  id_produto_gravity                 String?
  id_processo                        String
  id_status_anterior_processo        String?
  id_status_novo_processo            String
  id_usuario_mudanca_status_processo String?
  data_mudanca_status_processo       DateTime @default(now())
  observacao_mudanca_status_processo String?

  processo        Processo        @relation(fields: [id_processo], references: [id_processo], onDelete: Cascade)
  status_anterior ProcessoStatus? @relation("status_anterior_processo", fields: [id_status_anterior_processo], references: [id_processo_status], onDelete: SetNull)
  status_novo     ProcessoStatus  @relation("status_novo_processo", fields: [id_status_novo_processo], references: [id_processo_status], onDelete: Restrict)

  @@index([id_organizacao])
  @@index([id_organizacao, id_produto_gravity])
  @@index([id_organizacao, id_processo])
  @@index([id_organizacao, data_mudanca_status_processo])
  @@map("historico_status_processo")
}

// ─── LOGÍSTICA INTERNACIONAL (Tier A — roteiro planejado) ─────────────────────

model LogisticaInternacionalProcesso {
  id_logistica_internacional_processo String  @id @default(cuid())
  id_organizacao                      String
  id_produto_gravity                  String?
  id_processo                         String  @unique

  modal_frete_internacional_processo String?
  tipo_frete_internacional_processo  String?
  tipo_volume_processo               String?
  incoterm_processo                  String?

  porto_origem_processo      String?
  porto_destino_processo     String?
  porto_transbordo_processo  String?
  aeroporto_origem_processo  String?
  aeroporto_destino_processo String?
  aeroporto_escala_processo  String?

  id_agente_carga                     String?
  id_armador                          String?
  id_cia_aerea                        String?
  id_transportador_rodo_internacional String?
  id_transportador_rodo_nacional      String?
  id_transportador_ferroviario        String?
  id_despachante                      String?
  id_armazem_alfandegado              String?
  id_seguradora_internacional         String?

  data_criacao_logistica_internacional_processo     DateTime @default(now())
  data_atualizacao_logistica_internacional_processo DateTime @updatedAt

  processo Processo @relation(fields: [id_processo], references: [id_processo], onDelete: Cascade)

  @@index([id_organizacao])
  @@index([id_organizacao, id_produto_gravity])
  @@index([id_organizacao, id_processo])
  @@map("logistica_internacional_processo")
}

// ─── DADOS ADUANEIRO / FISCAL ─────────────────────────────────────────────────

model DadosProcesso {
  id_dados_processo  String  @id @default(cuid())
  id_organizacao     String
  id_produto_gravity String?
  id_processo        String  @unique

  canal_parametrizacao_processo String?
  numero_duimp_processo         String?
  numero_nfe_processo           String?
  chave_acesso_nfe_processo     String?

  data_registro_duimp_processo           DateTime?
  data_liberacao_duimp_processo          DateTime?
  data_consulta_liberacao_duimp_processo DateTime?
  data_previsao_registro_duimp_processo  DateTime?
  data_previsao_liberacao_duimp_processo DateTime?

  data_registro_lpco_processo           DateTime?
  data_deferimento_lpco_processo        DateTime?
  data_indeferimento_lpco_processo      DateTime?
  data_pendencia_lpco_processo          DateTime?
  data_consulta_liberacao_lpco_processo DateTime?
  data_previsao_registro_lpco_processo  DateTime?

  data_criacao_dados_processo     DateTime @default(now())
  data_atualizacao_dados_processo DateTime @updatedAt

  processo Processo @relation(fields: [id_processo], references: [id_processo], onDelete: Cascade)

  @@index([id_organizacao])
  @@index([id_organizacao, id_produto_gravity])
  @@index([id_organizacao, id_processo])
  @@map("dados_processo")
}

// ─── CÂMBIO (preferências locais — operação via BID-Câmbio link) ─────────────

model CambioProcesso {
  id_cambio_processo String  @id @default(cuid())
  id_organizacao     String
  id_produto_gravity String?
  id_processo        String  @unique

  id_banco_processo            String?
  id_corretora_cambio_processo String?

  data_criacao_cambio_processo     DateTime @default(now())
  data_atualizacao_cambio_processo DateTime @updatedAt

  processo Processo @relation(fields: [id_processo], references: [id_processo], onDelete: Cascade)

  @@index([id_organizacao])
  @@index([id_organizacao, id_produto_gravity])
  @@index([id_organizacao, id_processo])
  @@map("cambio_processo")
}

// ─── ESTIMATIVA DE CUSTO ────────────────────────────────────────────────────

model EstimativaProcesso {
  id_estimativa_processo String  @id @default(cuid())
  id_organizacao         String
  id_produto_gravity     String?
  id_processo            String  @unique

  total_imposto_ii_processo     Decimal? @db.Decimal(18, 6)
  total_imposto_ipi_processo    Decimal? @db.Decimal(18, 6)
  total_imposto_pis_processo    Decimal? @db.Decimal(18, 6)
  total_imposto_cofins_processo Decimal? @db.Decimal(18, 6)
  total_imposto_icms_processo   Decimal? @db.Decimal(18, 6)

  valor_frete_estimado_processo    Decimal? @db.Decimal(18, 6)
  valor_despacho_estimado_processo Decimal? @db.Decimal(18, 6)
  valor_outros_estimado_processo   Decimal? @db.Decimal(18, 6)
  valor_total_estimado_processo    Decimal? @db.Decimal(18, 6)
  moeda_estimativa_processo        String   @default("BRL")

  data_criacao_estimativa_processo     DateTime @default(now())
  data_atualizacao_estimativa_processo DateTime @updatedAt

  processo Processo @relation(fields: [id_processo], references: [id_processo], onDelete: Cascade)

  @@index([id_organizacao])
  @@index([id_organizacao, id_produto_gravity])
  @@index([id_organizacao, id_processo])
  @@map("estimativa_processo")
}

// ─── DOCUMENTOS ───────────────────────────────────────────────────────────────

model DocumentoProcesso {
  id_documento_processo String  @id @default(cuid())
  id_organizacao        String
  id_produto_gravity    String?
  id_usuario            String?
  id_processo           String

  nome_documento_processo          String
  tipo_arquivo_documento_processo  String
  tamanho_bytes_documento_processo Int    @default(0)
  url_documento_processo           String
  categoria_documento_processo     String @default("outro")

  numero_bl_processo                     String?
  numero_hawb_processo                   String?
  numero_mawb_processo                   String?
  numero_awb_processo                    String?
  numero_hbl_processo                    String?
  numero_mbl_processo                    String?
  numero_ce_mercante_processo            String?
  numero_certificado_origem_processo     String?
  numero_cim_processo                    String?
  numero_crt_processo                    String?
  numero_presenca_carga_destino_processo String?

  data_criacao_documento_processo DateTime @default(now())

  processo Processo @relation(fields: [id_processo], references: [id_processo], onDelete: Cascade)

  @@index([id_organizacao])
  @@index([id_organizacao, id_produto_gravity])
  @@index([id_organizacao, id_processo])
  @@index([id_organizacao, categoria_documento_processo])
  @@map("documento_processo")
}

// ─── CONTAINERS ───────────────────────────────────────────────────────────────

model ContainerProcesso {
  id_processo_container String  @id @default(cuid())
  id_organizacao        String
  id_produto_gravity    String?
  id_processo           String

  container_numero_processo_container          String
  container_tipo_processo_container            String?
  container_lacre_processo_container           String?
  container_tara_processo_container            Decimal?  @db.Decimal(18, 6)
  container_peso_bruto_processo_container      Decimal?  @db.Decimal(18, 6)
  container_peso_liquido_processo_container    Decimal?  @db.Decimal(18, 6)
  container_metragem_cubica_processo_container Decimal?  @db.Decimal(18, 6)
  local_devolucao_processo_container           String?
  data_devolucao_prevista_processo_container   DateTime?
  data_devolucao_real_processo_container       DateTime?

  data_criacao_container_processo     DateTime @default(now())
  data_atualizacao_container_processo DateTime @updatedAt

  processo Processo @relation(fields: [id_processo], references: [id_processo], onDelete: Cascade)

  @@index([id_organizacao])
  @@index([id_organizacao, id_produto_gravity])
  @@index([id_organizacao, id_processo])
  @@map("container_processo")
}

// ─── FOLLOW-UP ────────────────────────────────────────────────────────────────

model FollowUpProcesso {
  id_follow_up_processo String  @id @default(cuid())
  id_organizacao        String
  id_produto_gravity    String?
  id_usuario            String?
  id_processo           String

  titulo_follow_up_processo                String
  descricao_follow_up_processo             String?
  tipo_follow_up_processo                  String  @default("info")
  categoria_follow_up_processo             String  @default("sistema")
  id_usuario_registro_follow_up_processo   String?
  nome_usuario_registro_follow_up_processo String?

  data_criacao_follow_up_processo DateTime @default(now())

  processo Processo @relation(fields: [id_processo], references: [id_processo], onDelete: Cascade)

  @@index([id_organizacao])
  @@index([id_organizacao, id_produto_gravity])
  @@index([id_organizacao, id_processo])
  @@map("follow_up_processo")
}
