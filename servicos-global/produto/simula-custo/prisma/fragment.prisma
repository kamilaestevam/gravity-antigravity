// fragment.prisma — Simula Custo (produto simula-custo)
// Composto via prisma/compose-schema.js no schema final do produto.
// DDD aprovado pelo dono em TASK-000425 — entidade canônica: simula_custo.
// Padrão de campo: <campo>_<entidade>_<produto> (gabarito BID Frete Internacional).
// REGRA: todo model tenant DEVE ter id_organizacao e os índices obrigatórios.
// Skill: antigravity-tenant-isolation, antigravity-schema-composition, ddd-nomenclatura

// ─── Enums ──────────────────────────────────────────────────────────────────────
// Valores em PT-BR (exceção registrada na skill ddd-nomenclatura — termos COMEX).

enum TipoOperacaoSimulaCusto {
  IMPORTACAO
  EXPORTACAO
}

enum DetalheOperacaoSimulaCusto {
  DIRETA
  CONTA_ORDEM
  ENCOMENDA
  COMERCIAL_EXPORTADORA
}

enum StatusSimulaCusto {
  EM_CRIACAO
  CRIADA
  ARQUIVADA
}

enum TipoCobrancaSimulaCusto {
  PROCESSO
  CONTAINER
  AWB
  BL
  CRT
  KGS
  TON
  CAIXA
  M3
}

enum TipoDocumentoSimulaCusto {
  PEDIDO_COMPRA
  PEDIDO_VENDA
  PROFORMA
  INVOICE
  OUTRO
}

enum TipoValorPrazoPagamentoSimulaCusto {
  VALOR
  PERCENTUAL
}

enum MomentoPrazoPagamentoSimulaCusto {
  NO_DIA
  ANTES
  DEPOIS
}

enum FatoGeradorPrazoPagamentoSimulaCusto {
  PRODUCAO
  ENTREGA_NA_ORIGEM
  ENTREGA_NO_PORTO_DE_ORIGEM
  ENTREGA_NO_LOCAL_DE_ORIGEM
  ENTREGA_NO_DESTINO
  NO_BL
  ENTREGA_NO_PORTO_DE_DESTINO
  ENTREGA_NO_LOCAL_DE_DESTINO
  EMBARQUE_NO_DESTINO
  CHEGADA_NO_DESTINO
}

enum ModalidadeRecolhimentoIcmsSimulaCusto {
  INTEGRAL
  REDUCAO
  ISENTO
  DIFERIDO
}

// ─── Model principal ────────────────────────────────────────────────────────────

model SimulaCusto {
  id_simula_custo   String   @id @default(cuid())
  id_organizacao        String   // OBRIGATÓRIO — nunca nullable (tenant isolation)
  id_workspace          String   // OBRIGATÓRIO — isolamento por filial
  id_produto            String   @default("simula-custo")
  id_usuario            String   // id_usuario interno (CUID do Configurador) — criador
  id_processo           String?  // ref lógica — quando efetivada, atrela ao Processo real

  // Identificação
  numero_simula_custo      String   // EST-IMP-00001/26 ou manual alfanumérico
  referencia_simula_custo  String?  // referência interna (até 30 chars)
  tipo_operacao_simula_custo    TipoOperacaoSimulaCusto    @default(IMPORTACAO)
  detalhe_operacao_simula_custo DetalheOperacaoSimulaCusto @default(DIRETA)
  status_simula_custo           StatusSimulaCusto          @default(EM_CRIACAO)

  // Produto (NCM congelado no cálculo — catálogo vivo vem do Cadastros.NcmSync)
  ncm_simula_custo             String
  descricao_ncm_simula_custo   String?
  incoterm_simula_custo        String  @default("FOB")
  quantidade_simula_custo      Decimal @db.Decimal(15, 5) @default(0)
  moeda_produto_simula_custo   String  @default("USD")
  valor_produto_simula_custo   Decimal @db.Decimal(15, 2)

  // Frete internacional
  moeda_frete_simula_custo     String  @default("USD")
  valor_frete_simula_custo     Decimal @db.Decimal(15, 2) @default(0)
  enviar_solicitacao_cotacao_frete_simula_custo Boolean @default(false)

  // Seguro internacional
  moeda_seguro_simula_custo    String  @default("USD")
  valor_seguro_simula_custo    Decimal @db.Decimal(15, 2) @default(0)

  // ICMS
  uf_desembaraco_simula_custo  String   @default("SP")
  modalidade_recolhimento_icms_simula_custo ModalidadeRecolhimentoIcmsSimulaCusto @default(INTEGRAL)
  aliquota_icms_simula_custo   Decimal  @db.Decimal(5, 4) @default(0)
  usa_beneficio_simula_custo   Boolean  @default(false)

  // Impostos — alíquota (entrada/snapshot) + base e valor calculados por imposto
  aliquota_ii_simula_custo          Decimal  @db.Decimal(5, 4) @default(0)
  base_calculo_ii_simula_custo      Decimal? @db.Decimal(15, 2)
  valor_ii_simula_custo             Decimal? @db.Decimal(15, 2)
  reducao_ii_simula_custo           Decimal  @db.Decimal(5, 4) @default(0)

  aliquota_ipi_simula_custo          Decimal  @db.Decimal(5, 4) @default(0)
  base_calculo_ipi_simula_custo      Decimal? @db.Decimal(15, 2)
  valor_ipi_simula_custo             Decimal? @db.Decimal(15, 2)

  aliquota_pis_simula_custo          Decimal  @db.Decimal(5, 4) @default(0)
  base_calculo_pis_simula_custo      Decimal? @db.Decimal(15, 2)
  valor_pis_simula_custo             Decimal? @db.Decimal(15, 2)

  aliquota_cofins_simula_custo       Decimal  @db.Decimal(5, 4) @default(0)
  base_calculo_cofins_simula_custo   Decimal? @db.Decimal(15, 2)
  valor_cofins_simula_custo          Decimal? @db.Decimal(15, 2)

  base_calculo_icms_simula_custo     Decimal? @db.Decimal(15, 2)
  valor_icms_simula_custo            Decimal? @db.Decimal(15, 2)

  // Resultado calculado (BRL)
  ptax_utilizada_simula_custo             Decimal? @db.Decimal(10, 4)
  valor_aduaneiro_simula_custo            Decimal? @db.Decimal(15, 2)
  total_tributos_simula_custo             Decimal? @db.Decimal(15, 2)
  custo_nacionalizado_brl_simula_custo    Decimal? @db.Decimal(15, 2)
  fonte_calculo_simula_custo              String?  // 'siscomex' | 'gravity-engine' | 'fallback'

  // Relações — coleções com sufixo _simula_custo (decisão dono, paridade JSON = Prisma)
  taxas_origem_simula_custo     TaxaOrigemSimulaCusto[]
  taxas_destino_simula_custo    TaxaDestinoSimulaCusto[]
  documentos_simula_custo       DocumentoSimulaCusto[]
  prazos_pagamento_simula_custo PrazoPagamentoSimulaCusto[]

  // Timestamps
  data_criacao_simula_custo      DateTime @default(now())
  data_atualizacao_simula_custo  DateTime @updatedAt

  // Índices obrigatórios + consulta
  @@index([id_organizacao])
  @@index([id_workspace])
  @@index([id_organizacao, id_workspace])
  @@index([id_organizacao, id_produto])
  @@index([id_organizacao, id_usuario])
  @@index([id_organizacao, numero_simula_custo])
  @@index([id_organizacao, status_simula_custo])
  @@index([id_organizacao, ncm_simula_custo])
  @@index([id_processo])
  @@map("simula_custo")
}

// ─── Taxas origem/destino (gabarito BID Frete — ref lógica Cadastros.taxa_origem_destino) ──

model TaxaOrigemSimulaCusto {
  id_taxa_origem_simula_custo String  @id @default(cuid())
  id_organizacao                  String  // OBRIGATÓRIO
  id_workspace                    String  // OBRIGATÓRIO
  id_produto                      String  @default("simula-custo")
  id_usuario                      String?
  id_simula_custo             String
  id_taxa_origem_destino          String? // ref lógica Cadastros.taxa_origem_destino (sem FK física)

  nome_taxa_origem_simula_custo          String
  moeda_taxa_origem_simula_custo         String  @default("USD")
  tipo_cobranca_taxa_origem_simula_custo TipoCobrancaSimulaCusto @default(PROCESSO)
  valor_minimo_taxa_origem_simula_custo  Decimal @db.Decimal(15, 2) @default(0)
  valor_total_taxa_origem_simula_custo   Decimal @db.Decimal(15, 2)

  simula SimulaCusto @relation(fields: [id_simula_custo], references: [id_simula_custo], onDelete: Cascade)

  @@index([id_organizacao])
  @@index([id_organizacao, id_workspace])
  @@index([id_organizacao, id_produto])
  @@index([id_organizacao, id_usuario])
  @@index([id_organizacao, id_simula_custo])
  @@map("taxa_origem_simula_custo")
}

model TaxaDestinoSimulaCusto {
  id_taxa_destino_simula_custo String  @id @default(cuid())
  id_organizacao                   String  // OBRIGATÓRIO
  id_workspace                     String  // OBRIGATÓRIO
  id_produto                       String  @default("simula-custo")
  id_usuario                       String?
  id_simula_custo              String
  id_taxa_origem_destino           String? // ref lógica Cadastros.taxa_origem_destino (sem FK física)

  nome_taxa_destino_simula_custo          String
  moeda_taxa_destino_simula_custo         String  @default("USD")
  tipo_cobranca_taxa_destino_simula_custo TipoCobrancaSimulaCusto @default(PROCESSO)
  valor_minimo_taxa_destino_simula_custo  Decimal @db.Decimal(15, 2) @default(0)
  valor_total_taxa_destino_simula_custo   Decimal @db.Decimal(15, 2)

  simula SimulaCusto @relation(fields: [id_simula_custo], references: [id_simula_custo], onDelete: Cascade)

  @@index([id_organizacao])
  @@index([id_organizacao, id_workspace])
  @@index([id_organizacao, id_produto])
  @@index([id_organizacao, id_usuario])
  @@index([id_organizacao, id_simula_custo])
  @@map("taxa_destino_simula_custo")
}

// ─── Documentos vinculados ──────────────────────────────────────────────────────

model DocumentoSimulaCusto {
  id_documento_simula_custo String @id @default(cuid())
  id_organizacao                String // OBRIGATÓRIO
  id_workspace                  String // OBRIGATÓRIO
  id_produto                    String @default("simula-custo")
  id_usuario                    String?
  id_simula_custo           String

  tipo_documento_simula_custo   TipoDocumentoSimulaCusto
  numero_documento_simula_custo String // alfanumérico até 30 chars

  simula  SimulaCusto                  @relation(fields: [id_simula_custo], references: [id_simula_custo], onDelete: Cascade)
  anexos_documento_simula_custo  AnexoDocumentoSimulaCusto[]

  data_criacao_documento_simula_custo DateTime @default(now())

  @@index([id_organizacao])
  @@index([id_organizacao, id_workspace])
  @@index([id_organizacao, id_produto])
  @@index([id_organizacao, id_usuario])
  @@index([id_organizacao, id_simula_custo])
  @@map("documento_simula_custo")
}

// ─── Anexos de documento (binário S3/local + metadado) ─────────────────────────

model AnexoDocumentoSimulaCusto {
  id_anexo_documento_simula_custo              String @id @default(cuid())
  id_organizacao                                String
  id_workspace                                  String
  id_produto                                    String @default("simula-custo")
  id_usuario                                    String?
  id_documento_simula_custo                     String

  nome_arquivo_anexo_documento_simula_custo     String
  nome_original_anexo_documento_simula_custo    String
  tipo_arquivo_anexo_documento_simula_custo     String
  tamanho_bytes_anexo_documento_simula_custo    Int
  categoria_anexo_documento_simula_custo        String?
  chave_storage_anexo_documento_simula_custo    String
  enviado_por_anexo_documento_simula_custo      String

  documento DocumentoSimulaCusto @relation(fields: [id_documento_simula_custo], references: [id_documento_simula_custo], onDelete: Cascade)

  data_criacao_anexo_documento_simula_custo DateTime @default(now())

  @@index([id_organizacao])
  @@index([id_organizacao, id_workspace])
  @@index([id_organizacao, id_produto])
  @@index([id_organizacao, id_usuario])
  @@index([id_organizacao, id_documento_simula_custo])
  @@map("anexo_documento_simula_custo")
}

// ─── Prazos de pagamento (múltiplas linhas opcionais) ───────────────────────────

model PrazoPagamentoSimulaCusto {
  id_prazo_pagamento_simula_custo String @id @default(cuid())
  id_organizacao                      String
  id_workspace                        String
  id_produto                          String @default("simula-custo")
  id_usuario                          String?
  id_simula_custo                 String

  valor_prazo_pagamento_simula_custo           Decimal @db.Decimal(15, 4)
  tipo_valor_prazo_pagamento_simula_custo      TipoValorPrazoPagamentoSimulaCusto @default(PERCENTUAL)
  momento_prazo_pagamento_simula_custo         MomentoPrazoPagamentoSimulaCusto   @default(NO_DIA)
  dias_prazo_pagamento_simula_custo            Int     @default(0)
  fato_gerador_prazo_pagamento_simula_custo    FatoGeradorPrazoPagamentoSimulaCusto
  ordem_prazo_pagamento_simula_custo           Int     @default(0)

  simula SimulaCusto @relation(fields: [id_simula_custo], references: [id_simula_custo], onDelete: Cascade)

  @@index([id_organizacao])
  @@index([id_organizacao, id_workspace])
  @@index([id_organizacao, id_produto])
  @@index([id_organizacao, id_usuario])
  @@index([id_organizacao, id_simula_custo])
  @@map("prazo_pagamento_simula_custo")
}

// ─── Sequência de numeração ─────────────────────────────────────────────────────

model SequenciaSimulaCusto {
  id_sequencia_simula_custo            String @id @default(cuid())
  id_organizacao                           String
  id_usuario                               String
  ano_sequencia_simula_custo           Int
  ultimo_numero_sequencia_simula_custo Int    @default(0)

  @@unique([id_organizacao, id_usuario, ano_sequencia_simula_custo])
  @@index([id_organizacao])
  @@index([id_organizacao, id_usuario])
  @@map("sequencia_simula_custo")
}
