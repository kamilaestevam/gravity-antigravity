# Smart Read — Variáveis de Ambiente
# Copie para o .env da RAIZ DO PRODUTO (servicos-global/produto/smart-read/.env)
# Chaves globais (CHAVE_INTERNA_SERVICO) vêm do .env.local da raiz do monorepo.

# Servidor
PORT=8033
NODE_ENV=development

# URLs de outros serviços
CLIENT_URL=http://localhost:5185
CONFIGURATOR_URL=http://localhost:8005

# Smart Read legado (dati/microservices — internal-api)
# QA: https://qa-internal-api.dati-api.com
SMART_READ_LEGADO_URL=
# Secret compartilhado do header x-gravity-api-key (mesmo valor do GRAVITY_API_KEY do legado)
# Usado em external-readings (upload, listagem, GET leitura, PATCH result e download-tasks).
SMART_READ_LEGADO_CHAVE_GRAVITY=
# De-para id_organizacao (Gravity) -> company id (legado), JSON — override opcional por org
SMART_READ_DE_PARA_ORGANIZACAO={"exemplo-id-organizacao":"2"}
# Company id legado padrão para orgs com assinatura ATIVA (sem entrada no de-para)
SMART_READ_ID_COMPANY_LEGADO_PADRAO=2
# Dev: simula legado sem chave QA (extração mock ~3,5s). Desative quando tiver GRAVITY_API_KEY do legado.
SMART_READ_MOCK_LEGADO=1

# Banco Gravity do produto (Railway: gravity-smart-read-producao / -teste)
# Progresso do wizard, preferências de UI — não guarda PDF/extração (legado dati).
# Preferir SMART_READ_DATABASE_URL no .env.local da raiz (gitignored).
# Para dev local com Railway: copie DATABASE_PUBLIC_URL para .env.local como SMART_READ_DATABASE_URL.
SMART_READ_DATABASE_URL=postgresql://USER:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
